// MT-02: Per-company credential broker + encrypted secret storage
//
// Pipeline: research -> design -> implement -> test -> gate -> review -> exit
// Uses frontier model for architecture decisions, fast model for implementation.
//
// Run:
//   PYTHONPATH=... python3 run_pipeline.py templates/mt-02-credential-broker.dot \
//     --issue BEA-117 --workdir /path/to/mac-mcp-server

digraph CredentialBroker {
    graph [goal="Implement per-company credential broker with encrypted secret storage for the Multi-Tenant MCP server", default_max_retries=3]

    start [shape=Mdiamond, label="Start"]

    research [label="Research Codebase", class="frontier",
        prompt="Research the mac-mcp-server codebase to understand: (1) the Company model in db/models.py — what fields exist, especially auth_mode and any credential-related columns; (2) how credentials are currently used — search for MAC_CI_APP_ID, MAC_REGISTRY_PAT, ANTHROPIC_API_KEY references; (3) the existing database setup and Alembic migration patterns. Report findings in structured format."]

    design [label="Design Architecture", class="frontier",
        prompt="Based on the research, design the credential broker architecture: (1) Envelope encryption scheme — decide between KMS-managed keys and app-managed keys, define the key hierarchy; (2) New models — CredentialRow with company_id, credential_type (repo_token, llm_key), encrypted_secret, encryption_key_ref, and rotation metadata; (3) Broker interface — get_repo_credential(company_id) and get_llm_credential(company_id) with caching and redaction; (4) Alembic migration plan. Output as a technical design document."]

    implement [label="Implement Code", class="fast",
        prompt="Implement the credential broker based on the design: (1) Create auth/secrets/ module with envelope encryption, broker.py with the credential interface, and update models.py with CredentialRow; (2) Write the Alembic migration; (3) Ensure all secrets are encrypted at rest and redacted in logs; (4) Preserve saas_managed default behavior — global env vars must still work."]

    test [label="Run Tests", class="fast",
        prompt="Write and run tests: (1) Unit tests for envelope encryption round-trip (encrypt then decrypt); (2) Unit tests for broker — get_repo_credential and get_llm_credential return correct values per company; (3) Test that plaintext never appears in DB or logs; (4) Test saas_managed default falls back to env vars; (5) Test Alembic migration up/down."]

    gate [shape=diamond, label="Tests Pass?"]

    review [shape=house, label="Security Review", handler="wait.human",
        prompt="Review the credential broker implementation for security: Are secrets encrypted at rest? Is envelope encryption implemented correctly? Are there any plaintext leaks? Is the saas_managed fallback safe?"]

    exit [shape=Msquare, label="Done"]

    start -> research -> design -> implement -> test -> gate
    gate -> review [label="Yes", condition="outcome=success"]
    gate -> implement [label="No", condition="outcome!=success"]
    review -> exit [label="Approve"]
    review -> implement [label="Fix"]
}